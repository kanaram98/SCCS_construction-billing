{
  "name": "construction-billing",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "electron.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "npm run test:unit && npm run test:ui",
    "test:unit": "node --test \"tests/**/*.test.js\"",
    "test:ui": "vitest run",
    "test:watch": "vitest",
    "verify": "npm test && npm run build",
    "desktop": "npm run build && electron electron.cjs",
    "dist:win": "npm run build && electron-builder --win nsis portable --x64",
    "emulators": "firebase emulators:start --project demo-sccs"
  },
  "dependencies": {
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@mui/icons-material": "9.5.0",
    "@mui/material": "9.5.0",
    "html2canvas": "1.4.1",
    "jspdf": "4.2.1",
    "jspdf-autotable": "5.0.9",
    "qrcode-generator": "2.0.4",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@vitejs/plugin-react": "6.3.0",
    "electron": "45.3.3",
    "electron-builder": "26.18.0",
    "firebase-tools": "15.36.0",
    "jsdom": "30.1.3",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  },
  "overrides": {
    "app-builder-lib": {
      "minimatch": "11.0.8"
    },
    "@electron/universal": {
      "minimatch": "11.0.8"
    }
  },
  "build": {
    "appId": "com.constructionbilling.app",
    "productName": "Construction Billing",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron.cjs",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}

rules_version = '2';

// Security rules = the server-side validators for the cloud database.
//
// People and roles
// - owners/{email}: who may create a workspace. Added once by hand in the
//   Firebase console; the app can never write it.
// - workspaces/{wid}/members/{uid}: who is in the workspace and their role:
//     admin       everything, including members, permanent deletes,
//                 unlocking closed months and firm/bank details
//     contractor  daily work: bills, quotation, attendance, closing a month; he
//                 can ADD rates, workers and payments but only the admin edits
//                 or deletes them (he may mark a worker left / working)
// - workspaces/{wid}/invites/{email}: an admin invites a Google account; that
//   person becomes a member the first time they sign in.
//
// Every write is validated: allowed fields, types and sizes, the document id
// matches its path, `syncedAt` is the server time, the writer is recorded
// (`updatedBy` / `by`), and record versions only go up (a stale write from
// another device is rejected, so nothing is silently overwritten). Records
// are deleted for real only from the recycle bin, by an admin; history can't
// be edited.
//
// The same limits are in src/backend/schema.js; tests/rules checks both.
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Who ─────────────────────────────────────────────────────────────
    function signedIn() {
      return request.auth != null;
    }
    // Google sign-in emails are verified by Google; other sign-in methods need the verified flag.
    function verifiedEmail() {
      return signedIn() && request.auth.token.get('email', '') != ''
        && (request.auth.token.get('email_verified', false) == true
          || request.auth.token.firebase.sign_in_provider == 'google.com');
    }
    function memberPath(wid) {
      return /databases/$(database)/documents/workspaces/$(wid)/members/$(request.auth.uid);
    }
    function isMember(wid) {
      return signedIn() && exists(memberPath(wid));
    }
    function roleIn(wid, roles) {
      return isMember(wid) && get(memberPath(wid)).data.role in roles;
    }
    function isAdmin(wid) {
      return roleIn(wid, ['admin']);
    }
    function canWork(wid) {
      return roleIn(wid, ['admin', 'contractor']);
    }

    // Who may create a workspace: an account listed in owners/{email} (console),
    // or one of the emails baked in at deploy time (scripts/deploy.mjs replaces
    // the empty list below with OWNER_EMAILS from the untracked .env.production).
    function ownerEmails() {
      return [] /* OWNER_EMAILS */;
    }
    function isOwnerEmail() {
      return verifiedEmail()
        && (request.auth.token.email in ownerEmails()
          || exists(/databases/$(database)/documents/owners/$(request.auth.token.email)));
    }

    // ── Field checks ────────────────────────────────────────────────────
    function str(value, max) {
      return value is string && value.size() <= max;
    }
    function optStr(data, key, max) {
      return !(key in data) || str(data[key], max);
    }
    function numberish(value) {
      return value is number || str(value, 30);
    }
    function isoDate(value) {
      return value is string && value.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }
    function isMonth(value) {
      return value is string && value.matches('^[0-9]{4}-[0-9]{2}$');
    }
    function image(value) {
      return value == '' || (str(value, 700000) && value.matches('^data:image/[a-z+.-]+;base64,[A-Za-z0-9+/=]*$'));
    }
    function paymentMode(value) {
      return value in ['upi', 'cash', 'bank', 'cheque'];
    }
    function role(value) {
      return value in ['admin', 'contractor'];
    }

    function data() {
      return request.resource.data;
    }
    function fields(required, optional) {
      return data().keys().hasAll(required) && data().keys().hasOnly(required.concat(optional));
    }
    function serverTime() {
      return data().syncedAt == request.time;
    }
    function byMe(key) {
      return data()[key] == request.auth.uid;
    }

    // Records: sync metadata, id matches the path, writer recorded, versions only go up.
    function recordKeys() {
      return ['id', 'createdAt', 'updatedAt', 'deletedAt', 'version', 'updatedBy', 'syncedAt'];
    }
    function validMeta(id) {
      return data().id == id
        && str(data().createdAt, 40) && str(data().updatedAt, 40)
        && (data().deletedAt == null || str(data().deletedAt, 40))
        && data().version is int && data().version >= 1
        && str(data().updatedBy, 100)
        && (!('order' in data()) || (data().order is int && data().order >= 0))
        && serverTime();
    }
    function versionGoesUp() {
      return resource == null || data().version > resource.data.version;
    }
    // The author of a change is this account, or (for an older change being
    // uploaded for the first time) another member of the workspace.
    function isAuthor(wid, key) {
      return byMe(key) || exists(/databases/$(database)/documents/workspaces/$(wid)/members/$(data()[key]));
    }
    function writerRecorded(wid) {
      return byMe('updatedBy') || (resource == null && isAuthor(wid, 'updatedBy'));
    }
    // A contractor may change a worker only by marking them left / working.
    function onlyActiveChanged() {
      return data().diff(resource.data).affectedKeys().hasOnly(['active', 'updatedAt', 'version', 'updatedBy', 'syncedAt']);
    }
    function inRecycleBin() {
      return resource.data.deletedAt != null;
    }

    // ── Documents ───────────────────────────────────────────────────────
    function validBill(id) {
      let d = data();
      return fields(recordKeys().concat(['number', 'date', 'projectName', 'clientId', 'client', 'clientPhone',
          'clientAddress', 'clientGstin', 'firstLevelName', 'secondLevelName', 'discount', 'taxRate',
          'gstEnabled', 'gstType', 'advance', 'payments', 'footer', 'sections']),
          ['order', 'kind', 'isSample', 'projectId', 'raSeriesId', 'raNumber', 'convertedBillId', 'sourceEstimateId'])
        && validMeta(id)
        && str(d.number, 30) && str(d.date, 10)
        && (!('kind' in d) || d.kind in ['bill', 'estimate'])
        && (!('isSample' in d) || d.isSample is bool)
        && str(d.projectName, 200) && str(d.clientId, 100) && str(d.client, 200)
        && str(d.clientPhone, 30) && str(d.clientAddress, 5000) && str(d.clientGstin, 20)
        && str(d.firstLevelName, 50) && str(d.secondLevelName, 50)
        && numberish(d.discount) && numberish(d.taxRate) && numberish(d.advance)
        && d.gstEnabled is bool && d.gstType in ['intra', 'inter']
        && d.payments is list && d.payments.size() <= 500
        && str(d.footer, 5000)
        && d.sections is list && d.sections.size() <= 300
        && optStr(d, 'projectId', 100) && optStr(d, 'raSeriesId', 100) && (!('raNumber' in d) || (d.raNumber is int && d.raNumber >= 1))
        && optStr(d, 'convertedBillId', 100) && optStr(d, 'sourceEstimateId', 100);
    }

    function validRate(id) {
      let d = data();
      return fields(recordKeys().concat(['name', 'unit', 'type', 'rate']), ['order'])
        && validMeta(id)
        && str(d.name, 200) && str(d.unit, 20)
        && d.type in ['area', 'length', 'lenw', 'volume', 'count', 'direct']
        && numberish(d.rate);
    }

    function validClient(id) {
      let d = data();
      return fields(recordKeys().concat(['name', 'phone', 'address', 'gstin']), ['order'])
        && validMeta(id)
        && str(d.name, 200) && str(d.phone, 30) && str(d.address, 5000) && str(d.gstin, 20);
    }

    function validTemplate(id) {
      let d = data();
      return fields(recordKeys().concat(['name', 'type', 'content']), ['order'])
        && validMeta(id)
        && str(d.name, 200) && d.type in ['section', 'area'] && d.content is map;
    }

    function validProject(id) {
      let d = data();
      return fields(recordKeys().concat(['name', 'clientId', 'client', 'address', 'status', 'agreedAmount', 'notes']), ['order', 'clientPhone', 'clientAddress', 'clientGstin'])
        && validMeta(id)
        && str(d.name, 200) && str(d.clientId, 100) && str(d.client, 200) && str(d.address, 5000)
        && optStr(d, 'clientPhone', 200) && optStr(d, 'clientAddress', 5000) && optStr(d, 'clientGstin', 200)
        && d.status in ['running', 'completed'] && numberish(d.agreedAmount) && str(d.notes, 5000);
    }

    function validAdvance(id) {
      let d = data();
      return fields(recordKeys().concat(['projectId', 'date', 'amount', 'mode', 'note']), ['order'])
        && validMeta(id)
        && str(d.projectId, 100) && isoDate(d.date)
        && d.amount is number && d.amount >= 0
        && paymentMode(d.mode) && str(d.note, 5000);
    }

    function validExpense(id) {
      let d = data();
      return fields(recordKeys().concat(['projectId', 'date', 'amount', 'category', 'note']), ['order'])
        && validMeta(id)
        && str(d.projectId, 100) && isoDate(d.date)
        && d.amount is number && d.amount >= 0
        && d.category in ['food', 'travel', 'fuel', 'tools', 'stay', 'other'] && str(d.note, 5000);
    }

    function validWorker(id) {
      let d = data();
      return fields(recordKeys().concat(['name', 'phone', 'role', 'dailyWage', 'active']), ['order'])
        && validMeta(id)
        && str(d.name, 200) && str(d.phone, 30) && str(d.role, 100)
        && numberish(d.dailyWage) && d.active is bool;
    }

    function validLabourPayment(id) {
      let d = data();
      return fields(recordKeys().concat(['workerId', 'date', 'amount', 'mode', 'note']), ['order'])
        && validMeta(id)
        && str(d.workerId, 100) && isoDate(d.date)
        && d.amount is number && d.amount >= 0
        && paymentMode(d.mode) && str(d.note, 5000);
    }

    function validAttendanceMonth(month) {
      return fields(['id', 'marks', 'syncedAt'], [])
        && data().id == month && isMonth(month)
        && data().marks is map && data().marks.size() <= 31
        && serverTime();
    }

    function validHistoryEntry(wid, id, entities) {
      let d = data();
      return d.id == id && str(d.at, 40) && str(d.by, 100) && isAuthor(wid, 'by')
        && d.entity in entities
        && d.action in ['create', 'update', 'delete', 'restore', 'purge', 'close', 'unlock', 'conflict']
        && optStr(d, 'revertOf', 100)
        && d.keys().size() <= 20
        && serverTime();
    }

    function validFirm() {
      let d = data();
      return fields(['id', 'version', 'updatedBy', 'syncedAt', 'name', 'address', 'phone', 'gstin', 'gstRegistered',
          'bankName', 'accountName', 'accountNumber', 'ifsc', 'upiId', 'logo', 'signature', 'signatureLayout'],
          ['createdAt', 'updatedAt', 'brandingApplied', 'tagline'])
        && d.version is int && d.version >= 1 && versionGoesUp() && byMe('updatedBy')
        && str(d.name, 200) && optStr(d, 'tagline', 200) && str(d.address, 5000) && str(d.phone, 30) && str(d.gstin, 20)
        && d.gstRegistered is bool && str(d.bankName, 200) && str(d.accountName, 200)
        && str(d.accountNumber, 40) && str(d.ifsc, 20) && str(d.upiId, 100)
        && image(d.logo) && image(d.signature) && d.signatureLayout is map;
    }

    function validQuotation() {
      let d = data();
      return fields(['id', 'version', 'updatedBy', 'syncedAt', 'title', 'clientName', 'validDays', 'terms', 'disclaimer'], ['createdAt', 'updatedAt'])
        && d.version is int && d.version >= 1 && versionGoesUp() && byMe('updatedBy')
        && str(d.title, 200) && str(d.clientName, 200)
        && d.validDays is int && d.validDays >= 0 && d.validDays <= 3650
        && str(d.terms, 5000) && str(d.disclaimer, 5000);
    }

    function validPrintSettings() {
      return str(data().paper, 20) && str(data().orientation, 20) && data().keys().size() <= 40;
    }

    // ── Paths ───────────────────────────────────────────────────────────

    // Who may create a workspace. Readable by that account only, never written by the app.
    match /owners/{email} {
      allow read: if verifiedEmail() && request.auth.token.email == email;
      allow write: if false;
    }

    match /workspaces/{wid} {
      allow read: if isMember(wid);
      // Created once by an owner (see isOwnerEmail).
      allow create: if isOwnerEmail()
        && fields(['name', 'schemaVersion', 'createdAt', 'createdBy', 'syncedAt'], [])
        && str(data().name, 200) && data().schemaVersion is int && str(data().createdAt, 40)
        && byMe('createdBy') && serverTime();
      allow update: if isAdmin(wid)
        && fields(['name', 'schemaVersion', 'createdAt', 'createdBy', 'syncedAt'], [])
        && data().createdBy == resource.data.createdBy && str(data().name, 200) && serverTime();
      allow delete: if false;

      function validMember(uid) {
        return fields(['uid', 'name', 'email', 'role', 'addedAt', 'syncedAt'], [])
          && data().uid == uid && str(data().name, 200) && str(data().email, 200)
          && role(data().role) && str(data().addedAt, 40) && serverTime();
      }
      function invitePath(email) {
        return /databases/$(database)/documents/workspaces/$(wid)/invites/$(email);
      }

      match /members/{uid} {
        allow read: if isMember(wid);
        allow create: if request.auth.uid == uid && validMember(uid) && (
          // The workspace's creator becomes its first admin…
          (data().role == 'admin' && get(/databases/$(database)/documents/workspaces/$(wid)).data.createdBy == uid)
          // …everyone else joins through an invite for their own verified email, with the invited role.
          || (verifiedEmail() && data().email == request.auth.token.email
              && exists(invitePath(request.auth.token.email))
              && get(invitePath(request.auth.token.email)).data.role == data().role)
        );
        // Admins manage other people; nobody can change or remove their own membership (no lock-out).
        allow update: if isAdmin(wid) && uid != request.auth.uid && validMember(uid);
        allow delete: if isAdmin(wid) && uid != request.auth.uid;
      }

      match /invites/{email} {
        allow read: if isAdmin(wid) || (verifiedEmail() && request.auth.token.email == email);
        allow create, update: if isAdmin(wid)
          && fields(['email', 'role', 'invitedAt', 'invitedBy', 'syncedAt'], [])
          && data().email == email && role(data().role) && str(data().invitedAt, 40)
          && byMe('invitedBy') && serverTime();
        // Removed by an admin, or by the invited person once they have joined.
        allow delete: if isAdmin(wid) || (verifiedEmail() && request.auth.token.email == email && isMember(wid));
      }

      match /bills/{id} {
        allow read: if isMember(wid);
        allow create, update: if canWork(wid) && validBill(id) && versionGoesUp() && writerRecorded(wid);
        allow delete: if isAdmin(wid) && inRecycleBin();
      }
      // Rates, workers and labour payments: the contractor can add; only the admin edits or deletes.
      match /rates/{id} {
        allow read: if isMember(wid);
        allow create: if canWork(wid) && validRate(id) && versionGoesUp() && writerRecorded(wid);
        allow update: if isAdmin(wid) && validRate(id) && versionGoesUp() && writerRecorded(wid);
        allow delete: if isAdmin(wid) && inRecycleBin();
      }
      match /clients/{id} {
        allow read: if isMember(wid);
        allow create, update: if canWork(wid) && validClient(id) && versionGoesUp() && writerRecorded(wid);
        allow delete: if isAdmin(wid) && inRecycleBin();
      }
      match /templates/{id} {
        allow read: if isMember(wid);
        allow create, update: if canWork(wid) && validTemplate(id) && versionGoesUp() && writerRecorded(wid);
        allow delete: if isAdmin(wid) && inRecycleBin();
      }
      // Projects and client advances: the contractor adds; only the admin edits or deletes.
      match /projects/{id} {
        allow read: if isMember(wid);
        allow create: if canWork(wid) && validProject(id) && versionGoesUp() && writerRecorded(wid);
        allow update: if isAdmin(wid) && validProject(id) && versionGoesUp() && writerRecorded(wid);
        allow delete: if isAdmin(wid) && inRecycleBin();
      }
      match /advances/{id} {
        allow read: if isMember(wid);
        allow create: if canWork(wid) && validAdvance(id) && versionGoesUp() && writerRecorded(wid);
        allow update: if isAdmin(wid) && validAdvance(id) && versionGoesUp() && writerRecorded(wid);
        allow delete: if isAdmin(wid) && inRecycleBin();
      }
      // Site expenses: the contractor adds and edits (the app limits him to the last 3 days).
      match /expenses/{id} {
        allow read: if isMember(wid);
        allow create, update: if canWork(wid) && validExpense(id) && versionGoesUp() && writerRecorded(wid);
        allow delete: if isAdmin(wid) && inRecycleBin();
      }
      match /workers/{id} {
        allow read: if isMember(wid);
        allow create: if canWork(wid) && validWorker(id) && versionGoesUp() && writerRecorded(wid);
        allow update: if (isAdmin(wid) || (canWork(wid) && onlyActiveChanged()))
          && validWorker(id) && versionGoesUp() && writerRecorded(wid);
        allow delete: if isAdmin(wid) && inRecycleBin();
      }
      match /labourPayments/{id} {
        allow read: if isMember(wid);
        allow create: if canWork(wid) && validLabourPayment(id) && versionGoesUp() && writerRecorded(wid);
        allow update: if isAdmin(wid) && validLabourPayment(id) && versionGoesUp() && writerRecorded(wid);
        allow delete: if isAdmin(wid) && inRecycleBin();
      }
      // Marks are changed field by field (marks.DD.workerId), so two phones don't overwrite each other.
      match /attendance/{month} {
        allow read: if isMember(wid);
        allow create, update: if canWork(wid) && validAttendanceMonth(month);
        allow delete: if false;
      }
      match /closedMonths/{month} {
        allow read: if isMember(wid);
        allow create: if canWork(wid) && isMonth(month)
          && fields(['id', 'closedAt', 'closedBy', 'syncedAt'], []) && data().id == month
          && str(data().closedAt, 40) && str(data().closedBy, 100) && serverTime();
        allow update: if false;
        allow delete: if isAdmin(wid); // unlocking a month is admin-only
      }
      // History is append-only: entries can be added, never edited; only an admin may trim it.
      match /history/{id} {
        allow read: if isMember(wid);
        allow create: if canWork(wid) && validHistoryEntry(wid, id, ['bills', 'rates', 'clients', 'templates', 'projects', 'advances', 'expenses', 'firm', 'quotation']);
        allow update: if false;
        allow delete: if isAdmin(wid);
      }
      match /labourLog/{id} {
        allow read: if isMember(wid);
        allow create: if canWork(wid) && validHistoryEntry(wid, id, ['attendance', 'payment', 'worker', 'month']);
        allow update: if false;
        allow delete: if isAdmin(wid);
      }
      match /settings/{name} {
        allow read: if isMember(wid);
        allow create, update: if serverTime() && data().id == name && (
          (name == 'firm' && isAdmin(wid) && validFirm())
          || (name == 'quotation' && canWork(wid) && validQuotation())
          || (name == 'printSettings' && canWork(wid) && validPrintSettings())
        );
        allow delete: if false;
      }
    }
  }
}

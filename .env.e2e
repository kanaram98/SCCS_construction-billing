# Browser tests: their own emulators (firebase.e2e.json), never the ones you develop with.
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-sccs.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-sccs
VITE_FIREBASE_APP_ID=demo-app
VITE_USE_EMULATORS=true
VITE_WORKSPACE_ID=sccs
VITE_AUTH_EMULATOR_PORT=9199
VITE_FIRESTORE_EMULATOR_PORT=8180

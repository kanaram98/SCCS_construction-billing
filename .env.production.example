# Copy to .env.production and fill in from Firebase console:
# Project settings (gear) > General > Your apps > Web app > SDK setup and configuration.
# These are public identifiers (they are in every web page that uses Firebase);
# the database is protected by firestore.rules, not by hiding these.
VITE_FIREBASE_API_KEY=
# Keep the default <project-id>.firebaseapp.com: it is the only sign-in address Google has
# registered. (Using <project-id>.web.app gives "Access blocked: invalid request".)
VITE_FIREBASE_AUTH_DOMAIN=<project-id>.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=<project-id>
VITE_FIREBASE_APP_ID=
VITE_WORKSPACE_ID=sccs
